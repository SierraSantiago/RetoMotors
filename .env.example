# PostgreSQL / application Python
DATABASE_URL=

# PostgreSQL / dbt
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Supabase server/client configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo para tooling administrativo server-side; nunca usar en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# LLM — OpenAI via LangChain
LLM_PROVIDER=openai
OPENAI_API_KEY=
