# LLM
LLM_MODEL_PRIMARY=gpt-5-nano
LLM_MAX_COMPLETION_TOKENS=16384
LLM_REASONING_EFFORT=minimal
LLM_TIMEOUT_SECONDS=90

# Application
APP_ENV=development

# Frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
